{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.2",
  "plugins": ["./plugin/gasp-reviews"],
  "themes": ["./theme/gasp"],
  "mappings": {
    "wp-content/mu-plugins": "./dev/mu-plugins"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_ENVIRONMENT_TYPE": "local"
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp rewrite structure '/%postname%/' --hard"
  }
}
