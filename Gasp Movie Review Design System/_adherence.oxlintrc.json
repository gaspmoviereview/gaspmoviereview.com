{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "components/rating/**",
              "components/reviews/**",
              "components/tags/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorByline'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|avatar|href|meta|key|ref|className|style|children)$/]",
        "message": "<AuthorByline> doesn't accept that prop. Declared props: name, role, avatar, href, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GaspFactor'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|suspense|scariness|bloodiness|size|caption|key|ref|className|style|children)$/]",
        "message": "<GaspFactor> doesn't accept that prop. Declared props: score, suspense, scariness, bloodiness, size, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='GaspFactor'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:badge|compact|full)$/]",
        "message": "<GaspFactor> size must be one of 'badge' | 'compact' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GenreTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onClick|active|key|ref|className|style|children)$/]",
        "message": "<GenreTag> doesn't accept that prop. Declared props: children, href, onClick, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|title|excerpt|gasp|actions|minHeight|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: image, eyebrow, title, excerpt, gasp, actions, minHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|assetBase|alt|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, width, assetBase, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Logo> variant must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|excerpt|image|href|onClick|gasp|style|key|ref|className|style|children)$/]",
        "message": "<ReviewCard> doesn't accept that prop. Declared props: title, excerpt, image, href, onClick, gasp, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:assetBase|links|genres|onNavigate|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: assetBase, links, genres, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:assetBase|menuOpen|onMenuToggle|links|current|onNavigate|onHome|compact|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: assetBase, menuOpen, onMenuToggle, links, current, onNavigate, onHome, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|href|label|key|ref|className|style|children)$/]",
        "message": "<SocialButton> doesn't accept that prop. Declared props: icon, href, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|value|onChange|type|multiline|rows|hint|error|placeholder|required|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, name, value, onChange, type, multiline, rows, hint, error, placeholder, required."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email)$/]",
        "message": "<TextField> type must be one of 'text' | 'email'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
