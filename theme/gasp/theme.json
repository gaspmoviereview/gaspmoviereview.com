{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{ "slug": "ink-950", "name": "Ink (page)", "color": "#05080d" },
				{ "slug": "ink-900", "name": "Ink (card)", "color": "#0a1019" },
				{ "slug": "ink-850", "name": "Ink (panel)", "color": "#0f1724" },
				{ "slug": "bone-50", "name": "Bone", "color": "#f4efea" },
				{ "slug": "bone-300", "name": "Bone (secondary)", "color": "#b9b3ad" },
				{ "slug": "bone-500", "name": "Bone (muted)", "color": "#858079" },
				{ "slug": "gasp-red", "name": "Gasp Red", "color": "#ff4433" },
				{ "slug": "gasp-navy", "name": "Gasp Navy", "color": "#0d3a67" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1240px"
		},
		"spacing": {
			"customSpacingSize": false,
			"units": [ "px", "rem", "%" ]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Instrument Serif",
					"fontFamily": "'Instrument Serif', Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Instrument Serif", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-serif-latin-400-normal.woff2" ] },
						{ "fontFamily": "Instrument Serif", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-serif-latin-400-italic.woff2" ] }
					]
				},
				{
					"slug": "sans",
					"name": "Geist",
					"fontFamily": "Geist, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Geist", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/geist-latin-wght-normal.woff2" ] }
					]
				},
				{
					"slug": "mono",
					"name": "Geist Mono",
					"fontFamily": "'Geist Mono', ui-monospace, monospace",
					"fontFace": [
						{ "fontFamily": "Geist Mono", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/geist-mono-latin-wght-normal.woff2" ] }
					]
				}
			],
			"fontSizes": []
		},
		"blocks": {
			"core/image": { "border": { "radius": false } }
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--ink-950)", "text": "var(--wp--preset--color--bone-50)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "15px", "lineHeight": "1.55" },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--bone-50)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--gasp-red)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--bone-50)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.08", "letterSpacing": "-.01em" }
			},
			"h2": { "typography": { "fontSize": "40px" } },
			"h3": { "typography": { "fontSize": "28px" } },
			"h4": { "typography": { "fontSize": "22px" } }
		},
		"blocks": {
			"core/paragraph": {
				"color": { "text": "var(--wp--preset--color--bone-300)" },
				"typography": { "fontSize": "17px", "fontWeight": "300", "lineHeight": "1.75" }
			},
			"core/list": {
				"color": { "text": "var(--wp--preset--color--bone-300)" },
				"typography": { "fontSize": "17px", "fontWeight": "300", "lineHeight": "1.75" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--gasp-red)", "width": "2px", "style": "solid" } },
				"spacing": { "padding": { "left": "24px" } },
				"color": { "text": "var(--wp--preset--color--bone-50)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontStyle": "italic", "fontSize": "28px", "lineHeight": "1.35" },
				"css": "& p { font: inherit; color: inherit; margin: 0; }"
			},
			"core/separator": {
				"color": { "text": "rgba(255,255,255,.16)" }
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--ink-900)", "text": "var(--wp--preset--color--bone-50)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "13px" }
			}
		}
	}
}
